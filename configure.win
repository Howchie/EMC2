#!/bin/sh
# configure.win — Windows/UCRT configure entry point for EMC2.
#
# On Windows, R compiles from src/Makevars.win (Rtools 4.0) or src/Makevars.ucrt
# (UCRT toolchain), not src/Makevars. Those static files default to the legacy
# profile and `-include src/Makevars.profile`. This script resolves the
# --with-build-profile / EMC2_BUILD_PROFILE selector, writes that small profile
# fragment, and still generates src/Makevars from src/Makevars.in as the fallback
# for a plain R CMD SHLIB in src/.
#
# It deliberately does NOT probe OpenMP/SIMD (those are probed by the POSIX
# configure); OpenMP/SIMD stay off on Windows. It also does not assume /tmp or
# mktemp exist.
#
# Usage:
#   R CMD INSTALL --configure-args="--with-build-profile=compatibility" .
#   ./configure.win --help

set -u

ENV_PROFILE="${EMC2_BUILD_PROFILE:-}"
CLI_PROFILE=""

for arg in "$@"; do
  case "$arg" in
    --help|-h)
      cat <<EOF

configure.win options for EMC2:

  --with-build-profile=NAME   Select the build profile (default: legacy):
                                legacy         exact historical flags
                                compatibility  conservative, R default -O2
                                performance    opt-in -O3 -march=native
                                diagnostic     performance + optimisation reports
                              May also be set via EMC2_BUILD_PROFILE.

  --help, -h                  Show this help message and exit.

On Windows/UCRT this writes src/Makevars.profile, which src/Makevars.win and
src/Makevars.ucrt include, so the selected profile governs the actual build.
src/Makevars is still generated as the fallback used when those platform files
are absent (for example a plain R CMD SHLIB in src/).
EOF
      exit 0
      ;;
    --with-build-profile=*)
      CLI_PROFILE="${arg#*=}"
      ;;
    *)
      echo "configure.win: warning: unrecognised option '$arg' (ignored)" >&2
      ;;
  esac
done

# An explicit CLI value overrides the environment; conflicting values fail.
BUILD_PROFILE=""
if [ -n "$CLI_PROFILE" ] && [ -n "$ENV_PROFILE" ] && [ "$CLI_PROFILE" != "$ENV_PROFILE" ]; then
  echo "configure.win: error: conflicting build profile: --with-build-profile=$CLI_PROFILE vs EMC2_BUILD_PROFILE=$ENV_PROFILE" >&2
  exit 1
fi
if [ -n "$CLI_PROFILE" ]; then
  BUILD_PROFILE="$CLI_PROFILE"
elif [ -n "$ENV_PROFILE" ]; then
  BUILD_PROFILE="$ENV_PROFILE"
else
  BUILD_PROFILE="legacy"
fi

case "$BUILD_PROFILE" in
  legacy|compatibility|performance|diagnostic) ;;
  *)
    echo "configure.win: error: invalid --with-build-profile '$BUILD_PROFILE' (expected legacy, compatibility, performance, or diagnostic)" >&2
    exit 1
    ;;
esac

# Rtools uses GCC spellings for optimisation reports; OpenMP/SIMD are not probed
# here and remain off. These placeholders are kept in sync with the template.
DIAG_CXXFLAGS="-fopt-info-vec-optimized -fopt-info-vec-missed"
OMP_CXXFLAGS=""
OMP_LIBS=""
SIMD_CXXFLAGS=""
CONFIG_META="profile=${BUILD_PROFILE} openmp=not-probed openmp-simd=not-probed"

if [ ! -f src/Makevars.in ]; then
  echo "configure.win: error: src/Makevars.in not found" >&2
  exit 1
fi

# Write to PID-suffixed temp files in the package root, then move into place,
# so a failed substitution never leaves truncated output behind. No /tmp.
tmpfile="src/Makevars.tmp$$"
proftmp="src/Makevars.profile.tmp$$"
trap 'rm -f "$tmpfile" "$proftmp"' 0

sed \
  -e "s|@BUILD_PROFILE@|${BUILD_PROFILE}|g" \
  -e "s|@DIAG_CXXFLAGS@|${DIAG_CXXFLAGS}|g" \
  -e "s|@OMP_CXXFLAGS@|${OMP_CXXFLAGS}|g" \
  -e "s|@OMP_LIBS@|${OMP_LIBS}|g" \
  -e "s|@SIMD_CXXFLAGS@|${SIMD_CXXFLAGS}|g" \
  -e "s|@CONFIG_META@|${CONFIG_META}|g" \
  src/Makevars.in > "$tmpfile" || {
    echo "configure.win: error: failed to generate src/Makevars from src/Makevars.in" >&2
    exit 1
  }

mv -f "$tmpfile" src/Makevars || {
  echo "configure.win: error: failed to write src/Makevars" >&2
  exit 1
}

# Write the build-profile fragment that src/Makevars.win / src/Makevars.ucrt
# -include. It carries only BUILD_PROFILE; the profile flag matrix lives in
# those static files so a skipped configure still yields the legacy build.
printf 'BUILD_PROFILE = %s\n' "$BUILD_PROFILE" > "$proftmp" || {
  echo "configure.win: error: failed to write build-profile fragment" >&2
  exit 1
}
mv -f "$proftmp" src/Makevars.profile || {
  echo "configure.win: error: failed to write src/Makevars.profile" >&2
  exit 1
}

echo "configure.win: src/Makevars written (profile=${BUILD_PROFILE})"
exit 0
