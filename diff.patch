+                           rho_formula = rho ~ 1, formula = formula)
+  p <- set_bawl_values(
+    sampled_pars(ctx$design, doMap = FALSE),
+    rho = 0.98794615047395884,
+    v = 0, sv = 1, B = 1,
+    A = 0.030779275315645185,
+    t0 = 0.097614715654323642,
+    k = 0
