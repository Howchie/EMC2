+test_that("the stage's tau counts the spread between chains", {
+  set.seed(11)
+  ar <- function(n, rho, shift) {
+    x <- numeric(n)
+    for (t in 2:n) x[t] <- rho * x[t - 1L] + stats::rnorm(1, sd = sqrt(1 - rho^2))
+    x + shift
+  }
+  n <- 2000L
+  mixed <- lapply(1:3, function(i) cbind(ar(n, 0.5, 0), ar(n, 0.9, 0)))
+  tau <- EMC2:::.emc_alloc_geyer_tau(mixed)
+  expect_equal(tau, c(3, 19), tolerance = 0.25)
+  if (requireNamespace("posterior", quietly = TRUE)) {
+    arr <- simplify2array(mixed)
+    ref <- vapply(1:2, function(k) n * 3 / posterior::ess_basic(arr[, k, ]), numeric(1))
+    expect_equal(tau, ref, tolerance = 0.05)
+  }
+  # Chains held apart: each mixes quickly, but the stage has not.
+  apart <- lapply(1:3, function(i) cbind(ar(n, 0.5, c(-1, 0, 1)[i])))
+  expect_gt(EMC2:::.emc_alloc_geyer_tau(apart), 100)
+  expect_true(is.na(EMC2:::.emc_alloc_geyer_tau(list(matrix(1, 50, 1), matrix(1, 50, 1)))))
+  # kappa compares it with the AR(1) tau of the window's lag one.
+  expect_equal(EMC2:::.emc_alloc_kappa(c(30, 2, NA), c(0.5, 0.5, 0.5)), c(10, 1, 1))
+})
+
+test_that("a group unit's kappa scales the tau the solver compares", {
+  rs <- c(0.2, 0.7, 0.95)
+  expect_identical(EMC2:::.emc_alloc_eff(rs, NULL), rs)
+  expect_equal(EMC2:::.emc_alloc_tau(EMC2:::.emc_alloc_eff(rs, 4)), 4 * EMC2:::.emc_alloc_tau(rs))
+  expect_equal(EMC2:::.emc_alloc_eff(EMC2:::.emc_alloc_eff_inv(rs, 4), 4), rs)
+  sh <- function(kappa) list(kind = "shear", rho = 0.8, g = 0.5, a = 0.5, cost = 1, floor = 0,
+                             cap = 4, kappa = kappa)
+  u <- sh(3)
+  targets <- seq(0.85, 0.99, by = 0.01)
+  nd <- EMC2:::.emc_alloc_unit_need(u, targets, 4)
+  ok <- is.finite(nd$cost)
+  expect_true(any(ok))
+  got <- vapply(which(ok), function(i)
+    EMC2:::.emc_alloc_predict(list(u), list(x = nd$x[i]))[[1]], numeric(1))
+  expect_true(all(got <= targets[ok] + 1e-9))
+  # Batched pricing agrees with the unit's own, with and without kappa.
+  us <- list(sh(1), sh(3), list(kind = "fixed", rho = 0.5, cost = 0, kappa = 2))
+  batch <- EMC2:::.emc_alloc_units_need(us, rep(TRUE, 3), targets, 4)
+  for (i in 1:3) {
+    one <- EMC2:::.emc_alloc_unit_need(us[[i]], targets, 4)
+    expect_equal(batch[[i]]$cost, one$cost)
+    expect_equal(batch[[i]]$x[is.finite(one$cost)], one$x[is.finite(one$cost)])
+  }
+  # Of two coordinates alike in their window, rounds go to the one whose
+  # stage is slower.
+  sol <- EMC2:::.emc_alloc_solve(list(sh(1), sh(6)), C_rest = 5)
+  expect_gt(sol$x[2], sol$x[1])
+  expect_equal(sol$pred[[2]], EMC2:::.emc_alloc_eff(0.8 * EMC2:::.emc_alloc_factor(0.5, sol$x[2]), 6))
+})
