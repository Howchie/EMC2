+# The group coordinates' integrated autocorrelation time over the stage so
+# far (its last .EMC_ALLOC_STAGE_DRAWS draws in every chain): mu along the
+# directions Dinv inverts, then the log group sds. NA before the stage
+# holds .EMC_ALLOC_MIN_PAIRS draws.
+.EMC_ALLOC_STAGE_DRAWS <- 1000L
+.emc_alloc_stage_tau <- function(emc, Dinv, stage) {
+  p <- emc[[1L]]$n_pars
+  X <- lapply(emc, function(x) {
+    i <- x$samples$idx
+    lab <- if (is.null(stage)) x$samples$stage[i] else stage
+    k <- which(x$samples$stage[seq_len(i)] == lab)
+    k <- utils::tail(k, .EMC_ALLOC_STAGE_DRAWS)
+    if (length(k) < .EMC_ALLOC_MIN_PAIRS) return(NULL)
+    cbind(t(Dinv %*% x$samples$theta_mu[, k, drop = FALSE]),
+          t(.emc_alloc_lsd_draws(x$samples$theta_var, k)))
+  })
+  if (any(vapply(X, is.null, logical(1)))) return(rep(NA_real_, 2L * p))
+  X <- lapply(X, function(x) x[apply(is.finite(x), 1L, all), , drop = FALSE])
+  .emc_alloc_geyer_tau(X)
+}
+
+# The group coordinates' lag-one rho over the window's whole iterations
+# (consecutive stored draws of every chain), against the window variance.
+.emc_alloc_whole_rho <- function(emc, draws, Dinv, var) {
+  p <- emc[[1L]]$n_pars
+  sq <- numeric(2L * p)
+  n <- 0L
+  for (i in seq_along(emc)) {
+    k <- draws[[i]]
+    if (length(k) < 2L) next
+    s <- emc[[i]]$samples
+    x <- rbind(Dinv %*% s$theta_mu[, k, drop = FALSE], .emc_alloc_lsd_draws(s$theta_var, k))
+    d <- x[, -1L, drop = FALSE] - x[, -ncol(x), drop = FALSE]
+    d <- d[, apply(is.finite(d), 2L, all), drop = FALSE]
+    sq <- sq + rowSums(d^2)
+    n <- n + ncol(d)
+  }
+  if (n == 0L) return(rep(NA_real_, 2L * p))
+  .emc_alloc_rho(sq / n, var)
+}
+
+# A group coordinate's tau relative to the AR(1) one its window predicts:
+# the stage's against the window's whole iterations', at least one (and
+# one where either is missing).
+.emc_alloc_kappa <- function(tau_stage, rho_whole) {
+  k <- tau_stage / .emc_alloc_tau(rho_whole)
+  ifelse(is.finite(k), pmax(1, k), 1)
+}
