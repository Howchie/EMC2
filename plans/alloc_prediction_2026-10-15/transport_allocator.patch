+  lev <- EMC2:::.emc_alloc_level(u)
+  expect_equal(lev, EMC2:::.emc_alloc_transport_rho(0.003 + 0.1 * 0.01, 20L))
+  rs <- c(lev + 0.01, lev - 0.01, lev - 0.05, 0)
+  nd <- EMC2:::.emc_alloc_unit_need(u, rs, 4)
+  expect_equal(nd$x[1], 0.1)
+  reach <- is.finite(nd$cost)
+  for (i in which(reach & rs < lev))
+    expect_equal(EMC2:::.emc_alloc_transport_unit_rho(u, nd$x[i]), rs[i], tolerance = 1e-9)
+  expect_false(reach[4])
+  expect_equal(nd$cost[reach], 2 * nd$x[reach])
+  # HMC at the plan's mean rate adds its transport; the collapsed move adds
