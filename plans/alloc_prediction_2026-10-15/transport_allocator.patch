+# either kind's, else none beyond its exploration rounds.
+.emc_alloc_transport_units <- function(ms, tr, shear_on, c_round, bounds) {
+  n_g <- length(ms$g_rho)
+  p <- n_g / 2L
+  kind <- rep(1:2, each = p)
+  t0 <- function(f) { x <- tr$t[f, ]; ifelse(is.finite(x), x, 0) }
+  n_ev <- if (is.null(ms$g_n)) numeric(n_g) else ms$g_n
+  b_obs <- tr$t["shear", ]
+  meas <- is.finite(b_obs) & n_ev > 0
+  ref_of <- function(sel) if (any(sel)) sum(n_ev[sel] * b_obs[sel]) / sum(n_ev[sel]) else NA_real_
+  ref_all <- ref_of(meas)
+  n0 <- .EMC_ALLOC_ROUND_EVIDENCE
+  b <- numeric(n_g)
+  for (kk in 1:2) {
+    sel <- kind == kk
+    ref <- ref_of(meas & sel)
+    if (!is.finite(ref)) ref <- ref_all
