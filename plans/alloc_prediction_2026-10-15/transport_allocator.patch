+# A group coordinate's transport at horizon L: the mean squared change over
+# L iterations per iteration, against the coordinate's variance, which is
+# 2 (1 - rho^L) / L for an AR(1) of lag-one rho. A slow coordinate's lag-one
+# jumps are mostly undone within its conditional, so the allocation scores
+# the group on transport, and each move on its share of it: the coordinate's
+# rho is the AR(1)'s whose transport matches.
+.emc_alloc_transport_rho <- function(t, L) pmax(0, 1 - pmax(t, 0) * L / 2)^(1 / L)
+
+.emc_alloc_rho_transport <- function(rho, L) 2 * (1 - pmin(pmax(rho, 0), 1)^L) / L
+
+# One chain's transport per iteration by move family (rows, in the order of
+# .EMC_ALLOC_PATH_FAMILIES) and group coordinate (columns), against the
+# coordinates' variances v: P is its recorded path (.emc_alloc_record_path,
+# one row per iteration, the families' changes of the state statistic side
+# by side) and M maps the statistic to the coordinates. A family's share is
+# the covariance of its changes with the coordinate's change summed over
+# lags within L (Bartlett weights, rescaled at the window's ends to the
+# weight they hold): the shares add to the transport, and a move the
+# iterations around it undo earns nothing for it.
+.emc_alloc_transport_shares <- function(P, M, v, L) {
+  n_f <- length(.EMC_ALLOC_PATH_FAMILIES)
+  d_s <- ncol(M)
+  n <- nrow(P)
+  d <- lapply(seq_len(n_f), function(f)
+    P[, (f - 1L) * d_s + seq_len(d_s), drop = FALSE] %*% t(M))
+  tot <- Reduce(`+`, d)
+  w <- 1 - abs(seq.int(-(L - 1L), L - 1L)) / L
+  lagsum <- function(z) {
+    pad <- c(numeric(L - 1L), z, numeric(L - 1L))
+    stats::filter(pad, w, sides = 2L)[L - 1L + seq_len(n)]
+  }
+  held <- lagsum(rep(1, n))
+  sm <- apply(tot, 2L, lagsum) * (L / held)
+  sm <- matrix(sm, n)
+  out <- do.call(rbind, lapply(d, function(df) colMeans(df * sm) / v))
+  rownames(out) <- .EMC_ALLOC_PATH_FAMILIES
+  out
+}
+
+# Each move family's transport per move on chain j's group coordinates
+# (.emc_alloc_transport_shares), from every chain's window: mu along chain
+# j's shear directions (Dinv) and the log group sds, each measured on its
+# collective value, half the group's and half the subjects' (their mean,
+# their log spread), so moves of the subjects are credited for carrying the
+# group with them. Variances pool every chain's window draws, so a chain
+# held in one region moves little against them. A family's moves per
+# iteration pool over the chains: the subject moves per subject, shear
+# rounds per coordinate (a chain's own rounds on its mean directions, every
+# chain's on the log sds, which all chains share). A share below zero counts
+# as none; a family that did not run is NA. NULL without recorded paths.
+.emc_alloc_group_transport <- function(emc, j, Dinv, draws) {
+  ch <- emc[[j]]
+  p <- ch$n_pars
+  n_f <- length(.EMC_ALLOC_PATH_FAMILIES)
+  ok <- vapply(emc, function(x) {
+    w <- x$alloc$window
+    is.list(w) && is.matrix(w$Z) && nrow(w$Z) >= .EMC_ALLOC_MIN_PAIRS &&
+      ncol(w$Z) == n_f * 4L * p
+  }, logical(1))
+  if (!ok[j]) return(NULL)
+  zero <- matrix(0, p, p)
+  M <- 0.5 * rbind(cbind(Dinv, zero, Dinv, zero), cbind(zero, diag(p), zero, diag(p)))
+  X <- do.call(rbind, lapply(seq_along(emc), function(i) {
+    s <- emc[[i]]$samples
+    t(vapply(draws[[i]], function(t) .emc_alloc_state(s$theta_mu[, t], s$theta_var[, , t],
+                                                        s$alpha[, , t]), numeric(4L * p)))
+  }))
+  X <- X[apply(is.finite(X), 1L, all), , drop = FALSE]
+  if (nrow(X) < 3L) return(NULL)
+  v <- pmax(.emc_alloc_row_var(M %*% t(X)), .Machine$double.xmin)
+  n <- min(vapply(emc[ok], function(x) nrow(x$alloc$window$Z), numeric(1)))
+  L <- as.integer(max(2L, min(25L, floor(n / 4))))
+  n_g <- 2L * p
+  fam <- .EMC_ALLOC_PATH_FAMILIES
+  num <- matrix(0, n_f, n_g, dimnames = list(fam, NULL))
+  den <- matrix(0, n_f, n_g, dimnames = list(fam, NULL))
+  total <- numeric(n_g)
+  mean_k <- seq_len(p)
+  for (i in which(ok)) {
+    x <- emc[[i]]
+    w <- x$alloc$window
+    sh <- .emc_alloc_transport_shares(w$Z, M, v, L)
+    total <- total + colSums(sh)
+    it <- max(1, w$n)
+    ns <- x$n_subjects
+    per <- c(particle = if (is.null(w$nP)) 0 else sum(w$nP) / (ns * it),
+             group = 1,
+             collapsed = if (is.null(w$fam)) 0 else w$fam$collapsed$moves / it,
+             hmc = sum(w$hmc_att) / (ns * it))
+    for (f in names(per)) {
+      num[f, ] <- num[f, ] + sh[f, ]
+      den[f, ] <- den[f, ] + per[[f]]
+    }
+    if (.emc_shear_active(x) && is.list(x$shear$plan)) {
+      rec <- .emc_shear_record(x$shear$plan$last, p)
+      rate <- ifelse(rec$iters > 0, rec$n / pmax(rec$iters, 1), 0)
+      use <- rep(TRUE, n_g)
+      if (i != j) use[mean_k] <- FALSE
+      num["shear", use] <- num["shear", use] + sh["shear", use]
+      den["shear", use] <- den["shear", use] + rate[use]
+    }
+  }
+  per_move <- ifelse(den > 0, pmax(0, num) / pmax(den, .Machine$double.xmin), NA_real_)
+  list(t = per_move, moves = den, total = total / sum(ok), L = L, chains = sum(ok))
+}
