+# The moves of one iteration in order, each recorded by the change it makes
+# to the state statistic (.emc_alloc_state).
+.EMC_ALLOC_PATH_FAMILIES <- c("particle", "group", "shear", "collapsed", "hmc")
+
+# The state statistic the moves' paths are recorded in: the group mean, the
+# log group sds, the subjects' mean and the subjects' log spread.
+.emc_alloc_state <- function(mu, var, alpha) {
+  a <- matrix(alpha, length(mu))
+  c(as.numeric(mu), .emc_alloc_lsd(var), rowMeans(a),
+    0.5 * log(pmax(.emc_alloc_row_var(a), .Machine$double.xmin)))
+}
+
+# One iteration's path: states holds the statistic at the iteration's start
+# and after each family of .EMC_ALLOC_PATH_FAMILIES (rows); each family's
+# change is appended as one row of the window's Z.
+.emc_alloc_record_path <- function(sampler, states) {
+  d <- as.numeric(t(diff(states)))
+  if (!all(is.finite(d))) return(sampler)
+  w <- .emc_alloc_window(sampler)
+  w$Z <- rbind(w$Z, d)
+  sampler$alloc$window <- w
+  sampler
+}
