+# A transport unit's rho at x expected shear rounds per iteration: its
+# transport from the moves that always run (base), its rounds at their
+# measured transport each, and any collapsed moves (extra).
+.emc_alloc_transport_unit_rho <- function(u, x, extra = 0)
+  .emc_alloc_transport_rho(u$base + extra + x * u$b, u$L)
+
+# A transport unit at mean particle rate q and mean HMC rate r over the
+# subjects: its base transport and its rho with no rounds bought.
+.emc_alloc_transport_at <- function(u, q, r) {
+  u$base <- u$t_group + u$t_part * q + u$t_hmc * r
+  u$rho <- .emc_alloc_transport_unit_rho(u, 0)
+  u
+}
+
+# The subjects' mean particle and HMC rates under per-unit rates q and r.
+.emc_alloc_mean_rates <- function(units, q, r) {
+  subj <- which(vapply(units, function(x) identical(x$kind, "subject"), logical(1)))
+  if (!length(subj)) return(c(q = 1, r = 0))
+  c(q = mean(q[subj]), r = mean(r[subj]))
+}
+
+# Units that buy shear rounds.
+.emc_alloc_is_shear <- function(u)
+  identical(u$kind, "shear") || identical(u$kind, "transport") && isTRUE(u$shear)
