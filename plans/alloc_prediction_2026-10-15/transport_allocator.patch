+test_that("group transport pools the families' moves over chains", {
+  set.seed(7)
+  p <- 2L
+  ns <- 5L
+  k <- 60L
+  fam <- EMC2:::.EMC_ALLOC_PATH_FAMILIES
+  chain <- function() {
+    mu <- matrix(cumsum(stats::rnorm(k * p, sd = 0.1)), p)
+    al <- array(stats::rnorm(p * ns * k), c(p, ns, k))
+    for (t in seq_len(k)) al[, , t] <- al[, , t] + mu[, t]
+    tv <- array(diag(p), c(p, p, k))
+    st <- t(vapply(seq_len(k), function(t) EMC2:::.emc_alloc_state(mu[, t], tv[, , t], al[, , t]),
+                   numeric(4L * p)))
+    # The whole iteration's change goes to the ensemble update.
+    Z <- matrix(0, k - 1L, length(fam) * 4L * p)
+    g <- (match("group", fam) - 1L) * 4L * p + seq_len(4L * p)
+    Z[, g] <- diff(st)
+    list(n_pars = p, n_subjects = ns,
+         samples = list(idx = k, theta_mu = mu, theta_var = tv, alpha = al),
+         alloc = list(window = list(n = k - 1L, Z = Z, nP = rep(k - 1L, ns),
+                                    hmc_att = integer(ns),
+                                    fam = list(collapsed = list(moves = 0L)))))
+  }
+  emc <- list(chain(), chain(), chain())
+  local_mocked_bindings(.emc_shear_active = function(sampler) FALSE, .package = "EMC2")
+  draws <- lapply(emc, function(ch) seq_len(k))
+  tr <- EMC2:::.emc_alloc_group_transport(emc, 1L, diag(p), draws)
+  expect_equal(rownames(tr$t), fam)
+  expect_equal(tr$chains, 3L)
+  expect_true(all(tr$t["group", ] >= 0))
+  expect_true(all(is.na(tr$t[c("shear", "collapsed", "hmc"), ])))
+  expect_equal(unname(tr$t["particle", ]), rep(0, 2L * p))
+  # Every chain's whole change is the ensemble update's, so its share is the total.
+  expect_equal(unname(tr$t["group", ]), pmax(0, tr$total))
+  # Without a recorded path for the chain, no transport.
+  emc[[1]]$alloc$window$Z <- NULL
+  expect_null(EMC2:::.emc_alloc_group_transport(emc, 1L, diag(p), draws))
+})
