+              t_hmc = t0("hmc")[k], coll = t0("collapsed")[k], L = tr$L,
+              b = 0, cost = 0, floor = 0, cap = 0, rho_lag1 = ms$g_rho[k])
+    if (shear_on && is.finite(ms$g_fac[k])) {
+      bd <- bounds(n_ev[k], if (is.null(ms$g_iters)) 0 else ms$g_iters[k])
