+test_that("transport shares add to the L-step transport and credit only lasting moves", {
+  set.seed(31)
+  n <- 4000L
+  L <- 10L
+  rho <- 0.9
+  x <- numeric(n + 1L)
+  for (t in seq_len(n)) x[t + 1L] <- rho * x[t] + stats::rnorm(1, sd = sqrt(1 - rho^2))
+  # Five families on a one-coordinate statistic (d_s = 4, only the first
+  # entry moves): "group" carries the AR(1) step, "shear" adds a jump that
+  # "hmc" undoes within the same iteration.
+  jump <- stats::rnorm(n)
+  P <- matrix(0, n, 5L * 4L)
+  fam <- EMC2:::.EMC_ALLOC_PATH_FAMILIES
+  col <- function(f) (match(f, fam) - 1L) * 4L + 1L
+  P[, col("group")] <- diff(x)
+  P[, col("shear")] <- jump
+  P[, col("hmc")] <- -jump
+  M <- matrix(c(1, 0, 0, 0), 1L)
+  sh <- EMC2:::.emc_alloc_transport_shares(P, M, 1, L)
+  expected <- EMC2:::.emc_alloc_rho_transport(rho, L)
+  expect_equal(sum(sh), expected, tolerance = 0.15)
+  expect_equal(unname(sh["group", 1]), expected, tolerance = 0.15)
+  expect_lt(abs(sh[match("shear", fam), 1] + sh[match("hmc", fam), 1]), 0.02)
+  # rho from transport inverts the AR(1) map.
+  rs <- c(0, 0.3, 0.8, 0.97)
+  expect_equal(EMC2:::.emc_alloc_transport_rho(EMC2:::.emc_alloc_rho_transport(rs, L), L), rs,
+               tolerance = 1e-9)
+})
