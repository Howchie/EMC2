+  # scaled at the mean V, along D's columns and per parameter.
+  H <- lapply(fits, function(f) if (is.null(f)) matrix(0, p, p) else f$prec)
+  lin <- lapply(fits, function(f) if (is.null(f)) numeric(p) else f$lin)
+  Vbar <- Reduce(`+`, lapply(1:2, function(i) apply(emc[[i]]$samples$theta_var[, , draws[[i]]], 1:2, sum))) /
+    sum(lengths(draws))
+  Qbar <- lapply(H, function(h) h + solve(Vbar))
+  Z <- lapply(1:2, function(i) {
+    s <- emc[[i]]$samples
+    vapply(draws[[i]], function(t) {
+      Vi <- solve(s$theta_var[, , t])
+      y <- vapply(seq_len(n), function(j) {
+        Q <- H[[j]] + Vi
