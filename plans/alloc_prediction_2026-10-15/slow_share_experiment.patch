+# Every subject's position in its conditional given the group state, the
+# coordinates the shear and collapsed transports hold fixed (R/shear_move.R):
+# under its likelihood approximation (H_s, l_s) and prior N(mu, V) the
+# conditional is N(m_s, Q_s^-1), Q_s = H_s + V^-1, and y_s = Q_s (a_s - m_s)
+# = H_s a_s - l_s + V^-1 (a_s - mu) per draw (p x n x draws, per chain),
+# with Qbar_s = H_s + mean(V)^-1 to scale it. H_s = 0 without a usable
+# approximation. Shared by every chain's measurement through `cache`.
+.emc_alloc_resid <- function(emc, draws, cache = NULL) {
+  if (!is.null(cache) && identical(cache$resid_draws, draws)) return(cache$resid)
+  p <- emc[[1L]]$n_pars
+  n <- emc[[1L]]$n_subjects
+  fits <- .emc_shear_fits(emc[[1L]])
+  H <- lapply(fits, function(f) if (is.null(f)) matrix(0, p, p) else f$prec)
+  l <- lapply(fits, function(f) if (is.null(f)) numeric(p) else f$lin)
+  Vsum <- matrix(0, p, p)
+  nV <- 0
+  Y <- lapply(seq_along(emc), function(i) {
+    k <- draws[[i]]
+    s <- emc[[i]]$samples
+    y <- array(NA_real_, c(p, n, length(k)))
+    for (t in seq_along(k)) {
+      V <- s$theta_var[, , k[t]]
+      Vi <- tryCatch(chol2inv(chol(V)), error = function(e) NULL)
+      if (is.null(Vi)) next
+      Vsum <<- Vsum + V
+      nV <<- nV + 1
+      a <- matrix(s$alpha[, , k[t]], p)
+      y[, , t] <- Vi %*% (a - s$theta_mu[, k[t]])
+    }
+    for (j in seq_len(n)) {
+      a <- matrix(s$alpha[, j, k], p)
+      y[, j, ] <- y[, j, ] + H[[j]] %*% a - l[[j]]
+    }
+    y
+  })
+  Vbi <- if (nV > 0) tryCatch(chol2inv(chol(Vsum / nV)), error = function(e) NULL)
+  out <- if (is.null(Vbi)) NULL else list(y = Y, Q = lapply(H, function(h) h + Vbi))
+  if (!is.null(cache)) {
+    cache$resid_draws <- draws
+    cache$resid <- out
+  }
+  out
+}
+
+# Every group coordinate's (mu along the columns of dirs, then the log sds)
+# whole-iteration lag-one and lag-two autocorrelations over each chain's
+# draws, chains pooled, against the variances var (r1, r2), and the lag-one
+# autocorrelation of the subjects' statistic its slow part rides (s): their
+# mean standardised position in their conditionals along the coordinate's
+# direction, and the log root mean square of it along each parameter
+# (.emc_alloc_resid), which the group moves leave unchanged. NULL with too
+# few pairs.
+.emc_alloc_lag_rho <- function(emc, draws, dirs, var, cache = NULL) {
+  n_g <- length(var)
+  Dinv <- solve(dirs)
+  J <- list(numeric(n_g), numeric(n_g))
+  n <- c(0, 0)
+  for (i in seq_along(emc)) {
+    k <- draws[[i]]
+    if (length(k) < 3L) next
+    s <- emc[[i]]$samples
+    X <- rbind(Dinv %*% s$theta_mu[, k, drop = FALSE], .emc_alloc_lsd_draws(s$theta_var, k))
+    if (!all(is.finite(X))) next
+    m <- ncol(X)
+    for (l in 1:2) {
+      d <- X[, -seq_len(l), drop = FALSE] - X[, seq_len(m - l), drop = FALSE]
+      J[[l]] <- J[[l]] + rowSums(d^2)
+      n[l] <- n[l] + m - l
+    }
+  }
+  if (n[2L] < .EMC_ALLOC_MIN_PAIRS) return(NULL)
+  v <- 2 * pmax(var, .Machine$double.xmin)
+  out <- list(r1 = pmin(1, pmax(-1, 1 - J[[1L]] / n[1L] / v)),
+              r2 = pmin(1, pmax(-1, 1 - J[[2L]] / n[2L] / v)), s = rep(NA_real_, n_g))
+  rs <- .emc_alloc_resid(emc, draws, cache)
+  if (is.null(rs)) return(out)
+  p <- nrow(dirs)
+  n_s <- length(rs$Q)
+  Dt <- t(dirs)
+  c_d <- matrix(vapply(rs$Q, function(Q)
+    sqrt(pmax(colSums(dirs * (Q %*% dirs)), .Machine$double.xmin)), numeric(p)), p)
+  c_e <- matrix(vapply(rs$Q, function(Q) sqrt(pmax(diag(Q), .Machine$double.xmin)), numeric(p)), p)
+  Z <- lapply(rs$y, function(y) {
+    T <- dim(y)[3L]
+    if (T < 2L) return(NULL)
+    zm <- zs <- matrix(0, p, T)
+    for (j in seq_len(n_s)) {
+      yj <- matrix(y[, j, ], p)
+      zm <- zm + (Dt %*% yj) / c_d[, j]
+      zs <- zs + (yj / c_e[, j])^2
+    }
+    z <- rbind(zm / n_s, 0.5 * log(pmax(zs / n_s, .Machine$double.xmin)))
+    if (all(is.finite(z))) z
+  })
+  Z <- Z[!vapply(Z, is.null, logical(1))]
+  if (!length(Z)) return(out)
+  z_var <- .emc_alloc_row_var(do.call(cbind, Z))
+  z_jump <- Reduce(`+`, lapply(Z, function(z) rowSums((z[, -1L, drop = FALSE] -
+                                                        z[, -ncol(z), drop = FALSE])^2)))
+  z_n <- sum(vapply(Z, function(z) ncol(z) - 1, numeric(1)))
+  out$s <- pmin(1, pmax(0, 1 - z_jump / z_n / (2 * pmax(z_var, .Machine$double.xmin))))
+  out
+}
