+      }, numeric(p))
+      zm <- rowMeans(vapply(seq_len(n), function(j)
+        drop(t(D) %*% y[, j]) / sqrt(colSums(D * (Qbar[[j]] %*% D))), numeric(p)))
+      zs <- rowMeans(vapply(seq_len(n), function(j) (y[, j] / sqrt(diag(Qbar[[j]])))^2, numeric(p)))
+      c(zm, 0.5 * log(zs))
+    }, numeric(2 * p))
+  })
+  zv <- apply(do.call(cbind, Z), 1, stats::var)
+  sq <- Reduce(`+`, lapply(Z, function(z) rowSums((z[, -1] - z[, -ncol(z)])^2)))
+  m <- sum(vapply(Z, function(z) ncol(z) - 1, 0))
+  expect_equal(got$s, pmin(1, pmax(0, 1 - sq / m / (2 * zv))))
+  # A shear mean step (mu + u, each subject carried by Q_s^-1 V^-1 u) leaves
+  # the positions unchanged.
+  u <- c(0.7, -0.4)
+  moved <- emc
+  t <- 5
+  st <- moved[[1]]$samples
+  Vi <- solve(st$theta_var[, , t])
+  st$theta_mu[, t] <- st$theta_mu[, t] + u
+  for (j in seq_len(n)) st$alpha[, j, t] <- st$alpha[, j, t] + solve(H[[j]] + Vi, Vi %*% u)
+  moved[[1]]$samples <- st
+  r0 <- EMC2:::.emc_alloc_resid(emc, draws)
+  r1 <- EMC2:::.emc_alloc_resid(moved, draws)
+  expect_equal(r1$y[[1]][, , t - 2], r0$y[[1]][, , t - 2], tolerance = 1e-10)
 })
 
