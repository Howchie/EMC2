+  var <- c(1, 2, 0.5, 0.7)
+  got <- EMC2:::.emc_alloc_lag_rho(emc, draws, D, var)
+  X <- lapply(1:2, function(i) rbind(solve(D) %*% emc[[i]]$samples$theta_mu[, draws[[i]]],
