PKG_CXXFLAGS += -std=gnu++17 -Wfatal-errors -fmax-errors=1 -ftemplate-backtrace-limit=5
# -fno-finite-math-only is REQUIRED: -ffast-math would otherwise assume no NaN/Inf
# and break the ±Inf/NaN censoring comparisons (NA_REAL is a NaN). See src/Makevars.
override CXXFLAGS += -O3 -march=native -ffast-math -fno-finite-math-only -fno-math-errno -DUSE_FAST_PNORM
PKG_CPPFLAGS = $(RCPP_ARMA_CXXFLAGS) -I../inst/include -Igsl_bundled -finput-charset=utf-8 -Wfatal-errors -fmax-errors=1 -ftemplate-backtrace-limit=5 -DUSE_FAST_PNORM -DR_NO_REMAP
# GSL integration is compiled in via gsl_bundled.c — no system GSL needed
PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
# CXX_STD = C++11
