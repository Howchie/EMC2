# =============================================================================
# src/Makevars.in — template processed by ./configure into src/Makevars.
#
# DO NOT EDIT src/Makevars DIRECTLY: edit this file and re-run ./configure
# (R CMD INSTALL runs configure automatically during a source install).
#
# Build profiles — select with `./configure --with-build-profile=NAME`, or set
# the EMC2_BUILD_PROFILE environment variable:
#
#   legacy         Historical optimisation levels (DEFAULT): -O3 with the
#                  best -march selected by configure probing (falls back to
#                  -march=native), -ffast-math -fno-finite-math-only
#                  -fno-math-errno and USE_FAST_PNORM. Matches the
#                  pre-refactor optimisation levels; full OpenMP stays off.
#
#   compatibility  Conservative: R's default -O2, no -march=native, no
#                  -ffast-math, no -fno-math-errno. USE_FAST_PNORM and the
#                  NaN/Inf-safe comparison semantics are retained. Intended
#                  future default once the profile matrix is proven; it is
#                  opt-in in this slice.
#
#   performance    Opt-in native/vectorization: -O3 with the configure-probed
#                  -march (falls back to -march=native), -ffast-math
#                  -fno-finite-math-only -fno-math-errno, USE_FAST_PNORM.
#
#   diagnostic     performance profile flags plus compiler optimization/
#                  vectorization reports (GCC -fopt-info-* / Clang -Rpass=*).
#
# Windows builds (src/Makevars.win via configure.win) are unaffected and keep
# the literal -march=native flag; only this Unix Makevars.in path uses the
# configure-probed value.
#
# OpenMP-SIMD is probed by configure and -fopenmp-simd is added automatically
# whenever the compiler supports it; --disable-openmp-simd forces it off and
# --enable-openmp-simd requests it explicitly (warning if unsupported). Full
# OpenMP stays strictly opt-in (--enable-openmp) and independent of SIMD.
#
# Generated configuration records the probe outcome, the selected -march
# target, whether the SIMD flag was actually enabled, and make job count:
#   march = best probed -march level | native | none
#   openmp-simd-probe = available | unavailable   openmp-simd = on | off
#   make-jobs = configured MAKE_JOBS integer (0 disables injection)
#
# Generated configuration:
#   profile=legacy march=native openmp=available openmp-simd-probe=available openmp-simd=on make-jobs=29
# =============================================================================

# --- Parallel compilation (configure-selected job count) --------------------
# Configure chooses a safe default from CPU affinity, cgroup quotas, and
# MemAvailable. This standalone block remains profile-independent. Re-check
# live MAKEFLAGS so caller-supplied -j/--jobs and parent GNU Make jobservers
# always take precedence over the package default.
MAKE_JOBS := 29
ifneq ($(MAKE_JOBS),0)
ifeq ($(strip $(filter -j% --jobs% --jobserver-auth=% --jobserver-fds=%,$(MAKEFLAGS))),)
MAKEFLAGS += -j$(MAKE_JOBS)
endif
endif

BUILD_PROFILE = legacy

# Best -march target selected by configure probing (see configure); falls back
# to -march=native, or is empty when even -march=native fails the probe.
MARCH_CXXFLAGS = -march=native

# --- C++ language standard and baseline diagnostics (every profile) ----------
# -std=gnu++17 must appear after R's CXX (which embeds -std=gnu++20 on recent R)
# so that C++17 remains the effective standard, matching the historical build.
PKG_CXXFLAGS += -std=gnu++17 -Wfatal-errors -ftemplate-backtrace-limit=5  -fopenmp-simd

# USE_FAST_PNORM selects the fast standard-normal CDF approximation used by the
# Wald/RDM kernels. It is the current default and stays enabled in every profile
# until a compatibility-tested replacement exists.
USE_FAST_PNORM_FLAG = -DUSE_FAST_PNORM

# --- Profile-selected C++ optimization/vectorization flags -------------------
# R's ALL_CXXFLAGS places $(PKG_CXXFLAGS) before $(CXXFLAGS), so R's -O2 would
# win over an -O3 placed in PKG_CXXFLAGS. Profiles that require -O3 therefore
# append via `override CXXFLAGS +=` so their -O3 lands after R's default -O2.
ifeq ($(BUILD_PROFILE),legacy)
  override CXXFLAGS += -O3 $(MARCH_CXXFLAGS) -ffast-math -fno-finite-math-only -fno-math-errno $(USE_FAST_PNORM_FLAG)
else ifeq ($(BUILD_PROFILE),compatibility)
  PKG_CXXFLAGS += $(USE_FAST_PNORM_FLAG)
else ifeq ($(BUILD_PROFILE),performance)
  override CXXFLAGS += -O3 $(MARCH_CXXFLAGS) -ffast-math -fno-finite-math-only -fno-math-errno $(USE_FAST_PNORM_FLAG)
else ifeq ($(BUILD_PROFILE),diagnostic)
  override CXXFLAGS += -O3 $(MARCH_CXXFLAGS) -ffast-math -fno-finite-math-only -fno-math-errno $(USE_FAST_PNORM_FLAG)
  PKG_CXXFLAGS += -fopt-info-vec-optimized -fopt-info-vec-missed
else
  $(error EMC2: unknown build profile '$(BUILD_PROFILE)' (expected legacy, compatibility, performance, or diagnostic))
endif

# --- Profile-selected C optimization flags (bundled GSL sources) -------------
# gsl_bundled*.c (QAG/QAGS/QAGIU adaptive integration on the race-kernel paths)
# otherwise compiles at R's stock -O2 with no -march in every profile. Mirror
# the C++ optimisation level and march, but deliberately NOT the -ffast-math
# family: vendored GSL assumes IEEE semantics and its convergence/error paths
# rely on finite-math checks that -ffinite-math-only would elide.
ifeq ($(BUILD_PROFILE),legacy)
  override CFLAGS += -O3 $(MARCH_CXXFLAGS)
else ifeq ($(BUILD_PROFILE),performance)
  override CFLAGS += -O3 $(MARCH_CXXFLAGS)
else ifeq ($(BUILD_PROFILE),diagnostic)
  override CFLAGS += -O3 $(MARCH_CXXFLAGS)
endif

# --- Preprocessor flags: headers, RcppArmadillo, bundled GSL -----------------
# -Igsl_bundled makes <config.h> and <gsl/...> resolve to src/gsl_bundled/.
# These apply to both C and C++ so the bundled GSL C sources see their headers.
# The C++-only flags above are NOT inherited by the bundled GSL C sources.
PKG_CPPFLAGS += -I../inst/include $(RCPP_ARMA_CXXFLAGS) -Wfatal-errors -Igsl_bundled -DRCPP_NO_R_HEADERS_CHECK -DARMA_DONT_PRINT_FAST_MATH_WARNING -DR_NO_REMAP

# --- Link libraries -----------------------------------------------------------
# GSL is compiled in via gsl_bundled.c, so no -lgsl/-lgslcblas is required.
PKG_LIBS +=  $(RCPP_ARMA_LIBS)

# --- gfortran runtime search path ---------------------------------------------
# R's FLIBS (-lgfortran -lm -lquadmath) reaches the link through RcppArmadillo.
# On images whose default C++ compiler has no matching Fortran frontend (e.g.
# g++-13 without gfortran-13), -lgfortran fails to resolve even though the
# ABI-compatible libgfortran.so.5 runtime is present. Fall back to the directory
# reported by the installed gfortran; this is a no-op where that directory is
# already searched, and adds nothing when gfortran itself is absent.
GFORTRAN_LIBDIR := $(shell gfortran -print-file-name=libgfortran.so 2>/dev/null)
ifneq ($(wildcard $(GFORTRAN_LIBDIR)),)
PKG_LIBS += -L$(dir $(GFORTRAN_LIBDIR))
endif
